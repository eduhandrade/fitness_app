# PostgreSQL connection string (Neon, Supabase, Railway, Docker, etc.) — used
# by the running app. If your provider gives you a pooled connection string
# (PgBouncer, e.g. Neon's default), use it here.
DATABASE_URL="postgresql://user:password@localhost:5432/fitness_app?schema=public"

# Optional: a *direct* (unpooled) connection string, used only for running
# migrations. Only needed if DATABASE_URL above is pooled — pooled
# connections don't support the advisory lock `prisma migrate deploy` takes,
# and time out (P1002). Leave unset for local dev / an unpooled DATABASE_URL.
DIRECT_URL=""

# The very first account, created by `npx prisma db seed`, before any invite
# code exists to self-register with. Real login credentials.
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""
SEED_USER_NAME="Athlete"

# Required to create additional accounts at /signup. Anyone with this code
# can self-register their own, fully isolated account. Rotating it (redeploy
# with a new value) revokes it for everyone at once — there's no per-person
# tracking or revocation at this scale. Leaving it unset closes signup.
SIGNUP_INVITE_CODE=""

# 32-byte hex key used to encrypt Strava tokens at rest.
# Generate one with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Register an API application at https://www.strava.com/settings/api
# and set the Authorization Callback Domain to this app's host.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3000/api/strava/callback"
