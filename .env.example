# PostgreSQL connection string (Neon, Supabase, Railway, Docker, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/fitness_app?schema=public"

# Base URL of the deployed app + a random secret for NextAuth session encryption.
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# The single app user, created by `npx prisma db seed`.
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""
SEED_USER_NAME="Athlete"

# 32-byte hex key used to encrypt Strava tokens at rest.
# Generate one with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Register an API application at https://www.strava.com/settings/api
# and set the Authorization Callback Domain to this app's host.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3000/api/strava/callback"
